<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>Fatou Ngom — Frontend Developer</title>
<meta name="description" content="Personal portfolio of Fatou Ngom, a frontend developer in progress building modern, responsive and user-friendly websites." />
<meta name="theme-color" content="#16141c" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@500;600;800&family=Newsreader:opsz,wght@6..72,400&display=swap"
  rel="stylesheet"
/>
<style>
  /*
    Concept: the hero rendered as a live "editor window" — the actual
    tool of a frontend developer's trade. The role line is styled as a
    code comment (cursor still blinking — she's still writing it), the
    name is set in bold monospace, and the one paragraph in her own
    voice gets a warm serif. Palette: warm charcoal canvas, amber for
    identity/action, teal for the "live" state.
  */

  :root {
    --ink: #16141c;
    --panel: #1d1a24;
    --panel-line: rgba(243, 237, 226, 0.1);
    --paper: #f3ede2;
    --paper-soft: #cbc3b6;
    --mute: #948da0;
    --amber: #e9a23b;
    --amber-light: #f2ba6c;
    --amber-rgb: 233, 162, 59;
    --teal: #5cb99e;
    --teal-rgb: 92, 185, 158;
    --ink-on-amber: #1c1305;
  }

  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    background: var(--ink);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 2.5rem 1.5rem;
    background-color: var(--ink);
    background-image: radial-gradient(circle, rgba(243, 237, 226, 0.06) 1px, transparent 1.5px);
    background-size: 26px 26px;
  }

  .ambient-glow {
    position: absolute;
    top: 48%;
    left: 50%;
    width: min(900px, 140vw);
    height: min(900px, 140vw);
    transform: translate(-50%, -50%);
    background: radial-gradient(circle, rgba(var(--amber-rgb), 0.16), rgba(var(--teal-rgb), 0.07) 45%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .window {
    position: relative;
    z-index: 1;
    width: 100%;
    max-width: 720px;
    background: var(--panel);
    border: 1px solid var(--panel-line);
    border-radius: 16px;
    box-shadow:
      0 30px 80px -20px rgba(0, 0, 0, 0.65),
      0 45px 120px -40px rgba(var(--amber-rgb), 0.16);
    opacity: 0;
    transform: translateY(14px) scale(0.98);
    animation: cardIn 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
  }

  @keyframes cardIn {
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .chrome {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 1rem 1.35rem;
    border-bottom: 1px solid var(--panel-line);
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
  }
  .dot-a { background: var(--mute); }
  .dot-b { background: var(--teal); }
  .dot-c { background: var(--amber); }

  .content {
    padding: clamp(2.75rem, 6vw, 4.5rem) clamp(1.75rem, 5vw, 3.75rem);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .reveal {
    opacity: 0;
    transform: translateY(16px);
    animation: revealUp 0.7s cubic-bezier(0.2, 0.7, 0.2, 1) forwards;
    animation-delay: var(--d, 0s);
  }

  @keyframes revealUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .comment {
    font-family: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-weight: 500;
    font-size: clamp(0.85rem, 1.6vw, 0.98rem);
    color: var(--mute);
    letter-spacing: 0.01em;
    margin-bottom: 1.5rem;
  }

  .slash {
    color: var(--teal);
    margin-right: 0.35em;
  }

  .cursor {
    display: inline-block;
    width: 2px;
    height: 0.9em;
    margin-left: 4px;
    background: var(--teal);
    vertical-align: -0.1em;
    animation: blink 1.1s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50% { opacity: 0; }
  }

  .name {
    font-family: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-weight: 800;
    font-size: clamp(2.5rem, 8vw, 5rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--paper);
    margin-bottom: 1.6rem;
  }

  .name .accent {
    color: var(--amber);
  }

  .description {
    font-family: "Newsreader", Georgia, "Times New Roman", serif;
    font-weight: 400;
    font-size: clamp(1.05rem, 2vw, 1.2rem);
    line-height: 1.75;
    color: var(--paper-soft);
    max-width: 30em;
    margin: 0 auto clamp(2rem, 4vw, 2.75rem);
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 1rem 2.15rem;
    background: var(--amber);
    color: var(--ink-on-amber);
    font-family: "JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, Consolas, monospace;
    font-weight: 600;
    font-size: clamp(0.92rem, 1.4vw, 1rem);
    text-decoration: none;
    border-radius: 10px;
    box-shadow: 0 14px 32px -10px rgba(var(--amber-rgb), 0.55);
    transition: transform 0.3s ease, box-shadow 0.3s ease, background 0.3s ease;
  }

  .cta-icon {
    transition: transform 0.3s ease;
  }

  .cta:hover {
    background: var(--amber-light);
    transform: translateY(-3px);
    box-shadow: 0 20px 44px -10px rgba(var(--amber-rgb), 0.7);
  }

  .cta:hover .cta-icon {
    transform: translateX(2px);
  }

  .cta:active {
    transform: translateY(-1px);
  }

  .cta:focus-visible {
    outline: 2px solid var(--teal);
    outline-offset: 4px;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 1.75rem 1rem;
    }
    .cta {
      width: 100%;
      justify-content: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .window,
    .reveal,
    .cursor {
      animation: none !important;
      opacity: 1 !important;
      transform: none !important;
    }
    .cta {
      transition: none;
    }
    html {
      scroll-behavior: auto;
    }
  }
</style>
</head>
<body>
  <main>
    <section class="hero" aria-labelledby="hero-name">
      <div class="ambient-glow" aria-hidden="true"></div>
      <div class="window">
        <div class="chrome" aria-hidden="true">
          <span class="dot dot-a"></span>
          <span class="dot dot-b"></span>
          <span class="dot dot-c"></span>
        </div>
        <div class="content">
          <p class="comment reveal" style="--d:0.4s">
            <span class="slash">//</span>Frontend Developer in Progress<span class="cursor" aria-hidden="true"></span>
          </p>
          <h1 id="hero-name" class="name reveal" style="--d:0.55s">Fatou <span class="accent">Ngom</span></h1>
          <p class="description reveal" style="--d:0.7s">
            I’m passionate about creating modern, responsive and user-friendly websites. My goal is to become a professional frontend developer and build beautiful digital experiences.
          </p>
          <!-- Point this link to your projects page or section once it exists -->
          <a href="#" class="cta reveal" style="--d:0.85s">
            <svg class="cta-icon" width="14" height="14" viewBox="0 0 16 16" fill="none" aria-hidden="true">
              <path d="M4 2.5v11l9-5.5-9-5.5z" fill="currentColor" />
            </svg>
            <span>View My Projects</span>
          </a>
        </div>
      </div>
    </section>
  </main>
</body>
</html>
